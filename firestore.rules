rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Tasks: anyone signed in can read. Only the allow-listed admin
    // email, or a user whose profile doc has admin == true, can write.
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (
          request.auth.token.email == "mohamedishankunnummal@gmail.com" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
        );
    }

    // User profiles: any signed-in user can read (needed so the
    // identity-claim check can see who has already claimed which
    // student).
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && request.auth.uid == userId;

      // Admins can always fix a binding. A user can also write their
      // own doc, including changing claimedStudentId — that's the
      // "Switch student" feature in the UI. Uniqueness (no two
      // accounts on the same student) is enforced client-side via a
      // pre-write query (see findExistingClaim in auth.js), same as
      // it always was for the initial claim; it's a best-effort check
      // rather than a hard server-side guarantee, since Firestore
      // rules can't query "does any other doc already have this
      // value" without a dedicated claims collection keyed by
      // student id.
      allow update: if request.auth != null && (
        request.auth.token.email == "mohamedishankunnummal@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true ||
        request.auth.uid == userId
      );

      allow delete: if false;
    }
  }
}
